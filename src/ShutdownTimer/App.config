<?xml version="1.0" encoding="utf-8"?>
<!--
  这里原本有两节 .NET Framework 4.8 时代的配置，迁移到 .NET 8 后均已失效，故移除：

    <startup><supportedRuntime sku=".NETFramework,Version=v4.8"/></startup>
      → .NET 8 用 ShutdownTimer.runtimeconfig.json 决定运行时，不读这里。

    <System.Windows.Forms.ApplicationConfigurationSection><add key="DpiAwareness" .../></...>
      → .NET 8 不再读取该节；DPI 由 Program.cs 里的
        Application.SetHighDpiMode(HighDpiMode.PerMonitorV2) 决定。

  留着只会让人改错地方（改了不生效，还以为生效了）。
  文件本身保留：SDK 工程会把它作为 ShutdownTimer.dll.config 一并输出，
  将来若需要真正的运行时配置（如 assembly binding、TCPSocket settings）有处可写。
-->
<configuration>
  <configSections>
  </configSections>
</configuration>
