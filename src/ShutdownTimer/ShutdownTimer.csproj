<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <RootNamespace>ShutdownTimer</RootNamespace>
    <AssemblyName>ShutdownTimerClassic</AssemblyName>
    <ApplicationIcon>Icons\icon.display.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 程序集元数据单一真相源：这里声明，SDK 生成 AssemblyInfo（原先手写文件里只剩 SupportedOSPlatform）。
         Version 刻意用四段 1.3.3.0：Application.ProductVersion 取 InformationalVersion，
         Menu/Settings 的版本标签按"去掉最后一段"显示 v1.3.3，与上游行为一致。
         IncludeSourceRevisionInInformationalVersion=false：防止 ProductVersion 变成 "1.3.3.0+<gitsha>"，
         那会让 Helpers/Settings.cs 的版本迁移解析失败并误改写用户的 CountdownMode（见 CHANGELOG 版本注记）。 -->
    <Version>1.3.3.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>Shutdown Timer Classic</AssemblyTitle>
    <Description>Pick a time and let your pc shutdown itself even when you are not there.</Description>
    <Company>Lukas Langrock</Company>
    <Product>ShutdownTimerClassic</Product>
    <Copyright>Copyright © 2026</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <ComVisible>false</ComVisible>
    <Guid>ce23bd33-08d8-4895-854c-90d91cba02c6</Guid>

    <!-- 允许在 Linux/CI 等非 Windows 机器上编译 WinForms 目标 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- .NET 8 下 resx 内含二进制序列化对象，必须开启预序列化资源支持 -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>

    <!-- 本地化卫星程序集语言清单 -->
    <SatelliteResourceLanguages>en;zh-CN</SatelliteResourceLanguages>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

</Project>
