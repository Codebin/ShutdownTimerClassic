<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <RootNamespace>ShutdownTimer</RootNamespace>
    <AssemblyName>ShutdownTimerClassic</AssemblyName>
    <ApplicationIcon>Icons\icon.display.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 保留手写的 Properties/AssemblyInfo.cs（含 Guid、NeutralResourcesLanguage 等） -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- 允许在 Linux/CI 等非 Windows 机器上编译 WinForms 目标 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- .NET 8 下 resx 内含二进制序列化对象，必须开启预序列化资源支持 -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>

    <!-- 本地化卫星程序集语言清单 -->
    <SatelliteResourceLanguages>en;zh-CN</SatelliteResourceLanguages>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>1.3.3</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

</Project>
